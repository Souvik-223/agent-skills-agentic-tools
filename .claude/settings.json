{
  "permissions": {
    "allow": [
      "Bash(mkdir -p \".claude/skills/golang\" \".agents/skills/golang\")",
      "Bash(cp -r \"golang/golang-patterns\" \".claude/skills/golang/\")",
      "Bash(cp -r \"golang/golang-pro\" \".claude/skills/golang/\")",
      "Bash(cp -r \"golang/golang-testing\" \".claude/skills/golang/\")",
      "Bash(cp -r \"golang/golang-patterns\" \".agents/skills/golang/\")",
      "Bash(cp -f \"golang/golang-patterns/SKILL.md\" \".claude/skills/golang/golang-patterns/SKILL.md\")",
      "Bash(cp -f \"golang/golang-patterns/SKILL.md\" \".agents/skills/golang/golang-patterns/SKILL.md\")",
      "Bash(cp -f \"golang/golang-testing/SKILL.md\" \".claude/skills/golang/golang-testing/SKILL.md\")",
      "Bash(cp -f \"golang/golang-testing/SKILL.md\" \".agents/skills/golang/golang-testing/SKILL.md\")",
      "Bash(cp -f \"golang/golang-pro/SKILL.md\" \".claude/skills/golang/golang-pro/SKILL.md\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-context-monitor.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/gsd-statusline.js"
  }
}
